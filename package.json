{
  "name": "conexum",
  "private": true,
  "version": "0.1.0",
  "description": "Terminal-first SSH connection manager for macOS",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
